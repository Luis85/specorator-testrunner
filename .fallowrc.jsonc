{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // scripts/e2e-smoke.mjs esbuild-bundles this entry at runtime, which the
  // package.json-based auto-detection cannot see.
  "entry": ["scripts/e2e-smoke-entry.ts"],
  // CI gate (TD-006): the audit job in ci.yml is blocking. The verdict uses
  // new-only attribution (gates on findings a changeset introduces), so the
  // launch-default thresholds need no inventory-wide tuning. Caveat: any edit
  // to a file places that file's findings in scope, where pre-existing
  // complexity can surface (observed on PR #33; the runInitialization hot
  // spot it flagged was refactored in the pre-V2 Phase 1 increment). Revisit
  // the thresholds only if the blocking gate proves noisy in practice.
  "rules": {
    // Obsidian calls lifecycle/SuggestModal overrides (onChooseItem, getItems,
    // hide, getState, …) itself, so "unused" is structurally unreliable for
    // class members in this plugin. Keep the findings visible, never
    // verdict-driving. The framework/DI false positives are pinned as used
    // below so genuine findings are not buried under them (signal hygiene).
    "unused-class-members": "warn",
  },
  // Methods fallow's static graph cannot see a caller for because the call goes
  // through a framework runtime (Obsidian invokes view/modal overrides) or an
  // interface/DI seam (the concrete method is reached only through its port
  // type). All entries are trace-verified used; none are dead code. Scoped by
  // heritage so the suppression stays narrow — a genuinely-unused member on a
  // class outside these clauses is still reported.
  "usedClassMembers": [
    // Obsidian ItemView surface, overridden by the seven live views via the
    // shared LiveDashboardView base (live-dashboard-view.ts). Obsidian's
    // workspace calls these; our code never does.
    {
      "extends": "LiveDashboardView",
      "members": ["getViewType", "getDisplayText", "getIcon", "getState", "onOpen", "onClose"],
    },
    // Obsidian TextFileView surface (FeatureEditorView): identity + the
    // file-backed read/write/clear hooks the editor framework drives.
    {
      "extends": "TextFileView",
      "members": [
        "getViewType",
        "getDisplayText",
        "getIcon",
        "getViewData",
        "setViewData",
        "clear",
        "canAcceptExtension",
      ],
    },
    // Obsidian FuzzySuggestModal surface (the Run / Generate-feature pickers).
    {
      "extends": "FuzzySuggestModal",
      "members": ["getItems", "getItemText", "onChooseItem"],
    },
    // Port methods reached only through their interface type (DI seam), so the
    // concrete implementation looks callerless to the static graph.
    { "implements": "Logger", "members": ["debug"] },
    { "implements": "ChildProcessRunner", "members": ["disposeAll"] },
    { "implements": "PrdService", "members": ["findById", "withMutationLock"] },
    { "implements": "PrdLookup", "members": ["findById", "withMutationLock"] },
    { "implements": "TestExecutionService", "members": ["activeRunStartedAt"] },
    // PostRunCoordinator now has a port interface (DefaultPostRunCoordinator
    // implements PostRunCoordinator), so its DI-reached methods scope cleanly
    // here like the rest — consumed via composition-root closures / `Pick<>`.
    { "implements": "PostRunCoordinator", "members": ["start", "whenSettled", "importLastRun"] },
  ],
}
