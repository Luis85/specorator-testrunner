{
  "name": "obsidian-e2e-test-hub",
  "version": "0.0.1",
  "private": true,
  "description": "Obsidian E2E Test Hub — define, manage, execute, and document end-to-end tests directly inside your vault.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "test-build": "node scripts/test-build.mjs",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^2.1.9",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.0",
    "obsidian": "^1.13.1",
    "prettier": "^3.8.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^2.1.9"
  }
}
