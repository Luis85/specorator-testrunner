{
  "name": "obsidian-e2e-test-hub",
  "version": "0.0.1",
  "private": true,
  "description": "Obsidian E2E Test Hub — define, manage, execute, and document end-to-end tests directly inside your vault.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "test-build": "node scripts/test-build.mjs",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "fallow",
    "quality:health": "fallow health --score",
    "quality:dead-code": "fallow dead-code",
    "quality:dupes": "fallow dupes",
    "quality:audit": "fallow audit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.20",
    "builtin-modules": "^5.2.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "fallow": "^2.93.0",
    "obsidian": "^1.13.1",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
