{
  "name": "obsidian-e2e-test-hub",
  "version": "0.0.1",
  "private": true,
  "description": "Obsidian E2E Test Hub — define, manage, execute, and document end-to-end tests directly inside your vault.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@vitest/coverage-v8": "^2.1.9",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
